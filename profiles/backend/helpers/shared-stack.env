# shared-stack.env — settings of the pre-shared-stack gate snippet and testdb_conn.sh (sourced by both; bash syntax).
# One copy, in the MAIN tree's plan folder, so the gate, every worktree and focused runs agree on port, user and names.
# Edit every value for this project. Nothing here is a secret: the test DB password is generated into
# <plan dir>/.testdb-password (mode 600, gitignored with the plan folder) and never printed.
# Rules and the reason for each: references/shared-stack.md.

# ---- run slots and the stack lock -------------------------------------------------------------------------------
# Machine-wide cap of heavy phases (a unit-test phase or an E2E phase) across all trees. Accept a higher cap only after
# the acceptance proofs (connections ≤ 70 % of max, no swap growth).
export ES_RUN_SLOTS="${ES_RUN_SLOTS:-2}"
# Per-project lock path, so two projects on one machine never queue behind each other's stack.
export ES_STACK_LOCK_DIR="${ES_STACK_LOCK_DIR:-/tmp/es-myproject-stack.lock}"

# ---- test-only database (unit/integration tests; never the stack's database) ----------------------------------------
SS_TESTDB_COMPOSE="$HERE/helpers/docker-compose.testdb.yml"   # the MAIN tree's copy, so every tree starts the same container
SS_TESTDB_CONTAINER="myproject_testdb"
SS_TESTDB_PORT="5433"                                       # loopback only, never the stack's port
SS_TESTDB_USER="app_test"
SS_TESTDB_MAX_CONNECTIONS="200"                             # ≥ ES_RUN_SLOTS × peak per gate + headroom (measure it)
SS_TESTDB_ENV_NAME="APP_TEST_DB"                            # env var the test harness reads its connection string from
# printf format of that connection string; arguments: port, user, password.
SS_TESTDB_CONN_FORMAT='Host=127.0.0.1;Port=%s;Username=%s;Password=%s;Database=postgres'
# Planner settings: copy them from the MAIN database's config. They must be identical, or EXPLAIN-based tests see other plans.
SS_TESTDB_RANDOM_PAGE_COST="1.1"
SS_TESTDB_EFFECTIVE_CACHE_SIZE="1536MB"

# ---- shared stack (E2E) -------------------------------------------------------------------------------------------
SS_STACK_DB_CONTAINER="myproject_postgres"                  # fail fast when it is not healthy; watched by the sentinel
# Short ensure-ups of other shared services the unit tests need, as "<health check>|<ensure-up>" pairs. The ensure-up runs
# under a SHORT wrapped stack lock and only when the health check fails. Empty array = none.
SS_SHARED_ENSURE=(
  # 'test "$(docker inspect -f "{{.State.Health.Status}}" myproject_s3 2>/dev/null)" = healthy|docker compose up -d --no-recreate s3'
)
# The app containers E2E replaces. NAMED services + --no-deps only: a bare `up` recreates the shared DB whenever this
# tree's compose config hash differs from the running container's.
SS_E2E_STOP='docker stop -t 30 myproject_backend'           # graceful: the job scheduler releases its locks on shutdown
SS_E2E_UP='docker compose up -d --build --no-deps --wait --wait-timeout 300 backend'
SS_E2E_RESTORE='docker compose up -d --no-deps --force-recreate --wait --wait-timeout 300 backend'
# After a swap: `none` when the proxy re-resolves (nginx: `upstream { zone …; server backend:80 resolve; }` + `resolver`).
SS_PROXY_RESTART='docker compose restart nginx'
# Job-scheduler lock pre-check before an E2E boot: a command printing one line per lock row YOUNGER than the scheduler's
# lock timeout (empty output = go on), or none. Hangfire example (tree DB name from your own helper, never interpolated
# unchecked): docker exec myproject_postgres psql -U app -d "$TREE_DB" -tAc "select resource from hangfire.lock where now()-acquired < interval '10 min'"
SS_JOB_LOCK_CMD='none'
SS_JOB_LOCK_WAIT_SEC="600"
